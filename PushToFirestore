/* ========================================================================== */
/* PUSH ONE ROW                                                               */
/* ========================================================================== */

function pushRow_(sheet, rowNumber, spec) {
  const values = sheet.getRange(rowNumber, 1, 1, spec.columns).getValues()[0];

  if (spec.autofill) {
    const fills = spec.autofill(values, sheet, rowNumber) || [];
    fills.forEach(function (fill) {
      sheet.getRange(rowNumber, fill.col).setValue(fill.value);
      values[fill.col - 1] = fill.value;
    });
  }

  if (!spec.required(values)) return false;

  // Payment Methods sub-collection mein rehti hain
  if (spec.isSubcollection) {
    const methodId = clean_(values[0]);
    const uid = clean_(values[1]);
    const payload = stripEmpty_(spec.build(values));
    patchDocument_('students/' + uid + '/paymentMethods/' + methodId, payload);
    return true;
  }

  let docId = clean_(values[0]);
  let isNew = false;

  if (!docId) {
    docId = makeDocId_(spec.idPrefix);
    isNew = true;
  }

  const payload = stripEmpty_(spec.build(values));

  if (isNew && spec.onCreate) {
    const extra = spec.onCreate(values);
    Object.keys(extra).forEach(function (key) {
      if (extra[key] !== null && extra[key] !== undefined) payload[key] = extra[key];
    });
  }

  payload.updatedAt = new Date();

  patchDocument_(spec.collection + '/' + docId, payload);

  if (isNew) sheet.getRange(rowNumber, 1).setValue(docId);

  return true;
}

function stripEmpty_(payload) {
  const out = {};
  Object.keys(payload).forEach(function (key) {
    const value = payload[key];
    if (value === null || value === undefined) return;
    if (typeof value === 'string' && value === '') return;
    out[key] = value;
  });
  return out;
}

function makeDocId_(prefix) {
  const stamp = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyyMMddHHmmss');
  const random = Math.floor(Math.random() * 9000) + 1000;
  return prefix + '_' + stamp + '_' + random;
}

/* ========================================================================== */
/* CLAIM MATCHING                                                             */
/* ========================================================================== */

/**
 * Student ke claims ko Payment Entries se milata hai.
 *
 * KAAM KA TAREEQA
 *   1) Firestore se wo claims lo jo abhi tak kisi entry se nahi jure
 *   2) Har claim ke liye Payment Entries mein aisi rows dhoondo jahan:
 *        - wohi PayPal email ho
 *        - Student UID KHALI ho (matlab pool mein hai)
 *        - amount milta ho (Gross ya Net USD)
 *   3) Faisla:
 *        ek row mili, ek hi banda maang raha hai   -> khud verify
 *        ek row, do log maang rahe hain            -> dono review mein
 *        koi row nahi mili                          -> review mein
 *
 * Admin ne khud approve kiya ho to bhi ye function us claim ko
 * entry se jor deta hai, taake settlement mein ginti ho jaye.
 *
 * Ye sheet parhta hai, aur ab bhi sheet hi parhta hai. Dashboard se aayi
 * lines drainEntryQueue_ ke zariye sheet mein pohanch chuki hoti hain,
 * is liye yahan kuch badalne ki zaroorat nahi thi.
 */
function matchClaims() {
  const sheet = SpreadsheetApp.getActive().getSheetByName(TABS.entries);
  if (!sheet) return { checked: 0, matched: 0, review: 0 };

  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return { checked: 0, matched: 0, review: 0 };

  clearCaches_();

  const claims = listCollection_('paymentClaims').filter(function (doc) {
    const d = doc.data || {};
    const status = String(d.status || '').toLowerCase();
    if (d.linkedEntryId) return false;                 // pehle se jura hua
    return status === 'submitted' || status === 'verified' || status === 'under_review';
  });

  if (!claims.length) return { checked: 0, matched: 0, review: 0 };

  const rows = sheet.getRange(2, 1, lastRow - 1, 23).getValues();

  // --- pool: khali UID wali rows, email ke hisab se ---
  const pool = {};
  rows.forEach(function (r, i) {
    if (clean_(r[5])) return;                          // UID bhara hai, pool mein nahi

    const email = lower_(r[4]);
    if (!email) return;

    if (!pool[email]) pool[email] = [];
    pool[email].push({
      row: i + 2,
      gross: floatOrZero_(r[9]),
      net: floatOrZero_(r[11]),
      entryId: clean_(r[0])
    });
  });

  // --- kaun kaun ek hi cheez maang raha hai ---
  const demand = {};
  claims.forEach(function (doc) {
    const d = doc.data || {};
    const key = lower_(d.paypalEmail) + '||' + floatOrZero_(d.netUsd);
    demand[key] = (demand[key] || 0) + 1;
  });

  let matched = 0, review = 0;

  claims.forEach(function (doc) {
    const d = doc.data || {};
    const email = lower_(d.paypalEmail);
    const amount = floatOrZero_(d.netUsd);
    const uid = clean_(d.studentUid);
    const isApproved = String(d.status || '').toLowerCase() === 'verified';

    if (!email || !amount || !uid) return;

    const candidates = (pool[email] || []).filter(function (row) {
      return amountsMatch_(row.gross, amount) || amountsMatch_(row.net, amount);
    });

    // --- koi row nahi mili ---
    if (!candidates.length) {
      patchDocument_('paymentClaims/' + doc.id, {
        status: isApproved ? 'verified' : 'under_review',
        matchNote: 'Is amount ki koi khali entry nahi mili',
        updatedAt: new Date()
      });
      review++;
      return;
    }

    // --- ek se zyada log ek hi raqam maang rahe hain ---
    const key = email + '||' + amount;
    if (demand[key] > 1 && !isApproved) {
      patchDocument_('paymentClaims/' + doc.id, {
        status: 'under_review',
        matchNote: demand[key] + ' logon ne ' + amount + ' claim kiya hai',
        updatedAt: new Date()
      });
      review++;
      return;
    }

    // --- mil gaya: entry par student laga do ---
    const chosen = candidates[0];

    sheet.getRange(chosen.row, 6).setValue(uid);
    pushRow_(sheet, chosen.row, PUSH_SPECS[TABS.entries]);

    const entryId = clean_(sheet.getRange(chosen.row, 1).getValue()) || chosen.entryId;

    patchDocument_('paymentClaims/' + doc.id, {
      status: 'verified',
      linkedEntryId: entryId,
      matchNote: '',
      verifiedAt: new Date(),
      updatedAt: new Date()
    });

    notifyClaimVerified_(uid, d, amount);

    // ye row ab pool se nikal do
    pool[email] = pool[email].filter(function (row) { return row.row !== chosen.row; });
    matched++;
  });

  return { checked: claims.length, matched: matched, review: review };
}

/**
 * Menu se chalane ke liye — nateeja dikhata hai.
 */
function matchClaimsNow() {
  const result = matchClaims();

  SpreadsheetApp.getUi().alert(
    'Claim matching\n\n' +
    'Dekhe gaye claims: ' + result.checked + '\n' +
    'Khud match ho gaye: ' + result.matched + '\n' +
    'Review chahiye: ' + result.review +
    (result.review
      ? '\n\nReview wale claims Finance Admin dashboard ke Claims section mein hain.'
      : '')
  );
}

/**
 * Do raqmein barabar hain? Paison mein thora farq chalta hai.
 */
function amountsMatch_(a, b) {
  return Math.abs(Number(a || 0) - Number(b || 0)) < 0.01;
}

/**
 * Student ko bata dein ke us ka claim mil gaya.
 */
function notifyClaimVerified_(uid, claim, amount) {
  try {
    const id = makeDocId_('ntf');
    patchDocument_('notifications/' + id, {
      studentUid: uid,
      studentName: clean_(claim.studentName),
      title: 'Payment verified',
      message: 'Aap ka $' + amount + ' ka claim check ho gaya hai aur aap ki '
             + 'earnings mein shamil kar diya gaya hai.',
      isRead: false,
      isArchived: false,
      relatedId: clean_(claim.paypalEmail),
      createdAt: new Date(),
      updatedAt: new Date()
    });
  } catch (error) {
    console.error('Notification failed for ' + uid + ': ' + error);
  }
}

