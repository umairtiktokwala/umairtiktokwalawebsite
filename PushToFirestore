/**
 * Sab students ki payment methods ek collection group query se.
 * Verified By aur Notes sheet ke apne rehte hain.
 */
function syncPaymentMethods() {
  const sheet = SpreadsheetApp.getActive().getSheetByName(TABS.methods);
  if (!sheet) return;

  const old = readRowsByKey_(sheet, 1);
  const docs = runCollectionGroupQuery_('paymentMethods');

  const rows = docs.map(function (doc) {
    const d = doc.data;
    const previous = old[doc.id] || [];
    const uid = doc.parentId;

    const student = lookupStudent_(uid);

    return [
      doc.id,
      uid,
      firstNonEmpty_(student ? student.name : '', d.studentName, previous[2]),
      clean_(d.type),
      clean_(d.provider),
      clean_(d.accountTitle),
      clean_(d.accountIdentifier),
      clean_(d.last4),
      d.isPrimary === true ? 'Yes' : 'No',
      clean_(d.status) || 'pending_review',
      firestoreDate_(d.updatedAt),
      firestoreDate_(d.coolingUntil),
      firstNonEmpty_(d.verifiedBy, previous[12]),
      firstNonEmpty_(previous[13], d.notes)
    ];
  });

  writeDataRows_(sheet, rows, 14);
}

/**
 * Firestore REST — collection group query.
 * listCollection_ ye nahi kar sakti, is liye alag function.
 */
function runCollectionGroupQuery_(collectionId) {
  const projectId = getRequiredProperty_('FIREBASE_PROJECT_ID');
  const token = getAccessToken_();

  const url =
    'https://firestore.googleapis.com/v1/projects/' +
    encodeURIComponent(projectId) +
    '/databases/(default)/documents:runQuery';

  const body = {
    structuredQuery: {
      from: [{ collectionId: collectionId, allDescendants: true }],
      limit: 2000
    }
  };

  const response = UrlFetchApp.fetch(url, {
    method: 'post',
    contentType: 'application/json',
    payload: JSON.stringify(body),
    headers: { Authorization: 'Bearer ' + token },
    muteHttpExceptions: true
  });

  assertHttpOk_(response, 'Collection group query on ' + collectionId);

  const results = JSON.parse(response.getContentText() || '[]');
  const out = [];

  results.forEach(function (item) {
    if (!item || !item.document) return;

    const parts = item.document.name.split('/');
    const id = parts[parts.length - 1];
    const parentId = parts.length >= 3 ? parts[parts.length - 3] : '';

    out.push({
      id: id,
      parentId: parentId,
      data: decodeFields_(item.document.fields || {})
    });
  });

  return out;
}

