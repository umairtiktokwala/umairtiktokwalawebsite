/**
 * Settings tab ki values Firestore ke financeSettings/main mein bhejta hai,
 * taake dashboard wahan se rate aur commission parh sake.
 *
 * SHEET KA FORMAT
 *   Column A = Setting ka naam
 *   Column B = Value
 *   Column C = Notes (nazarandaz)
 *
 * PERCENT KA MASLA
 *   Google Sheets mein 15% wali cell ki asli value 0.15 hoti hai.
 *   Is liye: 1 se kam ho to fraction samjho (0.15 -> 15),
 *            1 se zyada ho to poora number samjho (15 -> 15).
 *   Aap format badlein to bhi hisab theek rahega.
 */
function syncSettings() {
  const sheet = SpreadsheetApp.getActive().getSheetByName(TABS.settings);
  if (!sheet) return null;

  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return null;

  const rows = sheet.getRange(2, 1, lastRow - 1, 2).getValues();
  const found = {};

  rows.forEach(function (row) {
    const label = clean_(row[0]).toLowerCase();
    if (!label) return;
    found[label] = row[1];
  });

  const payload = {
    usdToPkrRate:        numberOr_(found['usd to pkr rate'], 270),
    commissionBelowPct:  percentOr_(found['commission below threshold'], 15),
    commissionAbovePct:  percentOr_(found['commission at/above threshold'], 10),
    thresholdUsd:        numberOr_(found['commission threshold usd'], 1000),
    coolingHours:        numberOr_(found['payment method cooling hours'], 2),
    updatedAt:           new Date()
  };

  patchDocument_('financeSettings/main', payload);
  return payload;
}

/**
 * Menu se chalane ke liye — nateeja dikhata hai.
 */
function syncSettingsNow() {
  const s = syncSettings();

  if (!s) {
    SpreadsheetApp.getUi().alert('Settings tab nahi mila ya khali hai.');
    return;
  }

  SpreadsheetApp.getUi().alert(
    'Settings Firebase mein chali gayin\n\n' +
    'USD to PKR rate: ' + s.usdToPkrRate + '\n' +
    'Commission (threshold se kam): ' + s.commissionBelowPct + '%\n' +
    'Commission (threshold se upar): ' + s.commissionAbovePct + '%\n' +
    'Threshold: $' + s.thresholdUsd + '\n' +
    'Cooling: ' + s.coolingHours + ' ghante\n\n' +
    'Dashboard ab yehi values istemal karega.'
  );
}

/* ========================================================================== */
/* EDIT HANDLER                                                               */
/* ========================================================================== */

function handleSheetEdit(event) {
  if (!event || !event.range) return;

  const range = event.range;
  const sheet = range.getSheet();
  const name = sheet.getName();

  if (name === TABS.students) {
    handleFinanceSheetEdit(event);
    return;
  }

  // Settings badlein to foran Firebase mein bhej do
  if (name === TABS.settings) {
    try { syncSettings(); } catch (e) { console.error(e); }
    return;
  }

  const spec = PUSH_SPECS[name];
  if (!spec) return;
  if (range.getRow() < 2) return;

  const lock = LockService.getScriptLock();
  if (!lock.tryLock(15000)) return;

  try {
    clearCaches_();
    for (let row = range.getRow(); row <= range.getLastRow(); row++) {
      pushRow_(sheet, row, spec);
    }
  } catch (error) {
    console.error(error && error.stack ? error.stack : error);
  } finally {
    lock.releaseLock();
  }
}

function pushActiveSheetToFirebase() {
  const sheet = SpreadsheetApp.getActiveSheet();
  const name = sheet.getName();
  const spec = PUSH_SPECS[name];

  if (!spec) {
    SpreadsheetApp.getUi().alert(
      'Is tab ka push support nahi hai: "' + name + '"\n\n' +
      'Ye tabs kaam karte hain:\n' + Object.keys(PUSH_SPECS).join('\n')
    );
    return;
  }

  const lastRow = sheet.getLastRow();
  if (lastRow < 2) {
    SpreadsheetApp.getUi().alert('Is tab mein koi data nahi hai.');
    return;
  }

  clearCaches_();
  let pushed = 0, skipped = 0;

  for (let row = 2; row <= lastRow; row++) {
    if (pushRow_(sheet, row, spec)) pushed++; else skipped++;
  }

  SpreadsheetApp.getUi().alert(
    name + '\n\nFirebase mein bheji gayin: ' + pushed +
    ' rows\nChhori gayin (adhoori): ' + skipped + ' rows'
  );
}

/* ========================================================================== */
/* TAB DEFINITIONS                                                            */
/* ========================================================================== */

const PUSH_SPECS = {

  /* ---------------------------------------------------------------- */
  /* PAYMENT ENTRIES — har payment ka tafseeli record                  */
  /* A EntryID B Cycle C Date D PayPalID E Email F UID G Name H Phone  */
  /* I Type J Gross K Fee L Net M Comm% N CommUSD O PayableUSD         */
  /* P Rate Q PkrExact R PkrWhole S Status T Declined U Proof          */
  /* V AddedBy W Notes                                                 */
  /* ---------------------------------------------------------------- */
  'Payment Entries': {
    collection: 'paymentEntries',
    idPrefix: 'pe',
    columns: 23,
    required: function (v) {
      return clean_(v[4]) && (floatOrZero_(v[9]) > 0 || floatOrZero_(v[11]) > 0);
    },
    autofill: function (v, sheet, row) {
      const fills = [];

      // E: email khali ho to upar wali le lo
      let email = clean_(v[4]);
      if (!email) {
        email = fillDownFrom_(sheet, row, 5);
        if (email) fills.push({ col: 5, value: email });
      }
      email = String(email || '').toLowerCase();

      // D: PayPal ID email se — na mile to naya account bana do
      if (email && !clean_(v[3])) {
        const paypalId = paypalIdForEmail_(email, true);
        if (paypalId) fills.push({ col: 4, value: paypalId });
      }

      // B: mojooda mahina
      if (!clean_(v[1])) fills.push({ col: 2, value: currentCycleId_() });

      // C: aaj ki tareekh
      if (!clean_(v[2])) fills.push({ col: 3, value: new Date() });

      // F: phone likha ho to UID bana do
      const uidCell = clean_(v[5]);
      if (uidCell) {
        const resolved = resolveUid_(uidCell);
        if (resolved && resolved !== uidCell) {
          fills.push({ col: 6, value: resolved });
          v[5] = resolved;
        }
      }

      // G, H: naam aur number UID se
      const uid = clean_(v[5]);
      if (uid) {
        const student = lookupStudent_(uid);
        if (student) {
          if (!clean_(v[6]) && student.name)  fills.push({ col: 7, value: student.name });
          if (!clean_(v[7]) && student.phone) fills.push({ col: 8, value: student.phone });
        }
      }

      // S: status khali ho to Pending
      if (!clean_(v[18])) fills.push({ col: 19, value: 'Pending' });

      return fills;
    },
    build: function (v) {
      return {
        cycleId:        clean_(v[1]),
        paypalId:       clean_(v[3]),
        paypalEmail:    lower_(v[4]),
        studentUid:     clean_(v[5]),
        studentName:    clean_(v[6]),
        studentPhone:   clean_(v[7]),
        earningType:    clean_(v[8]),
        grossUsd:       floatOrZero_(v[9]),
        paypalFeeUsd:   floatOrZero_(v[10]),
        netUsd:         floatOrZero_(v[11]),
        commissionPct:  floatOrZero_(v[12]),
        commissionUsd:  floatOrZero_(v[13]),
        payableUsd:     floatOrZero_(v[14]),
        pkrRate:        floatOrZero_(v[15]),
        payablePkr:     intOrZero_(v[17]),
        status:         lower_(v[18]) || 'pending',
        declinedUsd:    floatOrZero_(v[19]),
        proofUrl:       clean_(v[20]),
        addedBy:        clean_(v[21]),
        notes:          clean_(v[22]),
        claimedBy:      clean_(v[5]) ? 'admin' : ''
      };
    },
    onCreate: function (v) {
      return { paymentDate: toFirestoreTimestamp_(v[2]) || new Date(), createdAt: new Date() };
    }
  },

  /* ---------------------------------------------------------------- */
  /* ASSIGNMENTS — email upar, neeche numbers                          */
  /* A ID B PayPalID C Email D UID E Name F Phone G Status H LinkedAt  */
  /* I EndedAt J EndReason K EmailPending L CreatedBy M Notes          */
  /* ---------------------------------------------------------------- */
  'Assignments': {
    collection: 'paypalAssignments',
    idPrefix: 'asg',
    columns: 13,
    required: function (v) {
      return clean_(v[3]);                       // student chahiye
    },
    autofill: function (v, sheet, row) {
      const fills = [];

      // C: email khali ho to upar wali
      let email = clean_(v[2]);
      if (!email) {
        email = fillDownFrom_(sheet, row, 3);
        if (email) fills.push({ col: 3, value: email });
      }
      email = String(email || '').toLowerCase();

      // B: PayPal ID — na mile to naya account bana do
      if (email && !clean_(v[1])) {
        const paypalId = paypalIdForEmail_(email, true);
        if (paypalId) fills.push({ col: 2, value: paypalId });
      }

      // D: phone likha ho to UID
      const uidCell = clean_(v[3]);
      if (uidCell) {
        const resolved = resolveUid_(uidCell);
        if (resolved && resolved !== uidCell) {
          fills.push({ col: 4, value: resolved });
          v[3] = resolved;
        }
      }

      // E, F: naam aur number
      const uid = clean_(v[3]);
      if (uid) {
        const student = lookupStudent_(uid);
        if (student) {
          if (!clean_(v[4]) && student.name)  fills.push({ col: 5, value: student.name });
          if (!clean_(v[5]) && student.phone) fills.push({ col: 6, value: student.phone });
        }
      }

      // G: status khali ho to linked
      if (!clean_(v[6])) fills.push({ col: 7, value: 'linked' });

      return fills;
    },
    build: function (v) {
      return {
        paypalId:           clean_(v[1]),
        currentEmail:       lower_(v[2]),
        studentUid:         clean_(v[3]),
        studentName:        clean_(v[4]),
        studentPhone:       clean_(v[5]),
        status:             lower_(v[6]) || 'linked',
        endedAt:            toFirestoreTimestamp_(v[8]),
        endReason:          clean_(v[9]),
        emailUpdatePending: yesToBool_(v[10]),
        createdBy:          clean_(v[11]),
        notes:              clean_(v[12])
      };
    },
    onCreate: function (v) {
      return {
        linkedAt:     toFirestoreTimestamp_(v[7]) || new Date(),
        paypalStatus: 'active',
        archived:     false
      };
    }
  },

  /* ---------------------------------------------------------------- */
  /* PAYPAL ACCOUNTS                                                   */
  /* ---------------------------------------------------------------- */
  'PayPal Accounts': {
    collection: 'paypalAccounts',
    idPrefix: 'pp',
    columns: 12,
    required: function (v) {
      return clean_(v[1]) || clean_(v[2]);
    },
    autofill: function (v) {
      const fills = [];
      const paypalId = clean_(v[0]);
      if (paypalId) {
        const count = countAssignmentsForPayPal_(paypalId);
        if (String(v[6]) !== String(count)) fills.push({ col: 7, value: count });
      }
      if (!clean_(v[4])) fills.push({ col: 5, value: 'active' });
      return fills;
    },
    build: function (v) {
      return {
        displayName:         clean_(v[1]),
        currentEmail:        lower_(v[2]),
        ownerName:           clean_(v[3]),
        status:              lower_(v[4]) || 'active',
        country:             clean_(v[5]),
        linkedStudentsCount: intOrZero_(v[6]),
        lastEmailChange:     toFirestoreTimestamp_(v[8]),
