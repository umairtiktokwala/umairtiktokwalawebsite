/* LOOKUPS                                                                    */
/* ========================================================================== */

let _studentCache = null;
let _phoneCache = null;
let _paypalCache = null;

function clearCaches_() {
  _studentCache = null;
  _phoneCache = null;
  _paypalCache = null;
}

function buildStudentCaches_() {
  if (_studentCache) return;

  _studentCache = {};
  _phoneCache = {};

  const sheet = SpreadsheetApp.getActive().getSheetByName(TABS.students);
  if (!sheet || sheet.getLastRow() < 2) return;

  const rows = sheet.getRange(2, 1, sheet.getLastRow() - 1, 3).getValues();

  rows.forEach(function (row) {
    const uid = clean_(row[0]);
    if (!uid) return;

    const name = clean_(row[1]);
    const phone = clean_(row[2]);

    _studentCache[uid] = { name: name, phone: phone };

    const normalized = normalizePhone_(phone);
    if (normalized && !_phoneCache[normalized]) _phoneCache[normalized] = uid;
  });
}

function lookupStudent_(uid) {
  buildStudentCaches_();
  return _studentCache[uid] || null;
}

/**
 * Agar phone number likha ho to usay UID mein badal deta hai.
 * UID pehle se ho to waisa hi wapas kar deta hai.
 */
function resolveUid_(value) {
  const text = clean_(value);
  if (!text) return '';

  // UID mein harf hote hain, phone mein sirf hindse
  const digitsOnly = /^[\d\s\+\-\(\)]+$/.test(text);
  if (!digitsOnly) return text;

  buildStudentCaches_();
  const normalized = normalizePhone_(text);
  return _phoneCache[normalized] || text;
}

/**
 * Email se PayPal ID. createIfMissing true ho to naya account bhi bana deta hai.
 */
function paypalIdForEmail_(email, createIfMissing) {
  const key = String(email || '').toLowerCase().trim();
  if (!key) return '';

  if (!_paypalCache) {
    _paypalCache = {};
    const sheet = SpreadsheetApp.getActive().getSheetByName(TABS.paypals);

    if (sheet && sheet.getLastRow() > 1) {
      const rows = sheet.getRange(2, 1, sheet.getLastRow() - 1, 3).getValues();
      rows.forEach(function (row) {
        const id = clean_(row[0]);
        const mail = clean_(row[2]).toLowerCase();
        if (id && mail) _paypalCache[mail] = id;
      });
    }
  }

  if (_paypalCache[key]) return _paypalCache[key];
  if (!createIfMissing) return '';

  // Nayi PayPal account bana do
  const sheet = SpreadsheetApp.getActive().getSheetByName(TABS.paypals);
  if (!sheet) return '';

  const id = makeDocId_('pp');
  const row = new Array(12).fill('');
  row[0] = id;
  row[1] = key.split('@')[0];
  row[2] = key;
  row[4] = 'active';
  row[10] = 'No';

  const target = Math.max(sheet.getLastRow() + 1, 2);
  sheet.getRange(target, 1, 1, 12).setValues([row]);

  patchDocument_('paypalAccounts/' + id, {
    displayName: row[1],
    currentEmail: key,
    status: 'active',
    archived: false,
    createdAt: new Date(),
    updatedAt: new Date()
  });

  _paypalCache[key] = id;
  return id;
}

function countAssignmentsForPayPal_(paypalId) {
  const sheet = SpreadsheetApp.getActive().getSheetByName(TABS.assignments);
  if (!sheet || sheet.getLastRow() < 2) return 0;

  const rows = sheet.getRange(2, 2, sheet.getLastRow() - 1, 6).getValues();
  let count = 0;

  rows.forEach(function (row) {
    if (clean_(row[0]) !== paypalId) return;
    const status = clean_(row[5]).toLowerCase();
    if (status === 'ended' || status === 'unlinked') return;
    count++;
  });

  return count;
}

function getPrimaryPaymentMethod_(uid) {
  try {
    const methods = listCollection_('students/' + uid + '/paymentMethods');
    if (!methods.length) return null;

    let chosen = null;
    methods.forEach(function (doc) {
      const d = doc.data || {};
      if (String(d.status || '').toLowerCase() === 'inactive') return;
      if (d.isPrimary === true) chosen = { id: doc.id, data: d };
    });

    if (!chosen) chosen = { id: methods[0].id, data: methods[0].data || {} };

    const d = chosen.data;
    const last4 = clean_(d.last4);

    return {
      id: chosen.id,
      type: clean_(d.type),
      provider: clean_(d.provider),
      accountTitle: clean_(d.accountTitle),
      masked: last4 ? '•••• ' + last4 : ''
    };
  } catch (error) {
    console.error('Payment method lookup failed for ' + uid + ': ' + error);
    return null;
  }
}

/**
 * Upar ki taraf dekh kar pehli bhari hui value dhoondta hai.
 * Isi se "email ek dafa, neeche khali" wala tareeqa chalta hai.
 */
function fillDownFrom_(sheet, rowNumber, column) {
  for (let row = rowNumber - 1; row >= 2; row--) {
    const value = clean_(sheet.getRange(row, column).getValue());
    if (value) return value;
  }
  return '';
}

/* ========================================================================== */
/* SMALL HELPERS                                                              */
/* ========================================================================== */

function currentCycleId_() {
  return Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM');
}

function normalizePhone_(value) {
  let n = String(value || '').replace(/\D/g, '');
  if (n.indexOf('00') === 0) n = n.substring(2);
  if (n.indexOf('0') === 0) n = '92' + n.substring(1);
  if (n.indexOf('920') === 0) n = '92' + n.substring(3);
  if (n.indexOf('3') === 0 && n.length === 10) n = '92' + n;
  return n;
}

function lower_(value) {
  return clean_(value).toLowerCase();
}

function yesToBool_(value) {
  if (value === true) return true;
  if (value === false) return false;
  const text = clean_(value).toLowerCase();
  return text === 'yes' || text === 'true' || text === 'y' || text === '1';
}

function intOrZero_(value) {
  const number = Number(String(value).replace(/[^0-9.\-]/g, ''));
  if (!isFinite(number)) return 0;
  return Math.round(number);
}

function floatOrZero_(value) {
  const number = Number(String(value).replace(/[^0-9.\-]/g, ''));
  if (!isFinite(number)) return 0;
  return Math.round(number * 100) / 100;
}

function round2_(value) {
  return Math.round(Number(value || 0) * 100) / 100;
}

/**
 * Percent ki value — chahe 0.15 ho ya 15, dono se 15 nikalta hai.
 * Google Sheets ki percent cell 0.15 deti hai, is liye ye zaroori hai.
 */
function percentOr_(value, fallback) {
  const n = Number(String(value === undefined ? '' : value).replace(/[^0-9.\-]/g, ''));
  if (!isFinite(n) || n <= 0) return fallback;
  if (n > 0 && n < 1) return Math.round(n * 10000) / 100;
  return Math.round(n * 100) / 100;
}

function numberOr_(value, fallback) {
  const n = Number(String(value === undefined ? '' : value).replace(/[^0-9.\-]/g, ''));
  if (!isFinite(n) || n <= 0) return fallback;
  return Math.round(n * 100) / 100;
}
