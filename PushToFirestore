/**
 * Naya menu. Naam onOpen NAHI rakha ja sakta — wo purani Code.gs mein
 * pehle se hai, aur do ek jaise naam Apps Script mein error dete hain.
 * Is liye ye installable onOpen trigger se chalta hai.
 */
function buildFinanceMenu() {
  SpreadsheetApp.getUi()
    .createMenu('UTW Finance')
    .addItem('Sync everything now', 'syncAllV4')
    .addItem('Import new entries now', 'drainEntryQueueNow')
    .addItem('Match claims now', 'matchClaimsNow')
    .addItem('Push settings to Firebase', 'syncSettingsNow')
    .addSeparator()
    .addItem('Push this tab to Firebase', 'pushActiveSheetToFirebase')
    .addSeparator()
    .addItem('Install automatic sync (v4)', 'installSyncV4')
    .addToUi();
}

/**
 * Purana sync + settings + payment methods + naye entries + claim matching.
 * Har 5 minute chalta hai.
 *
 * Tarteeb ahem hai: naye entries claim matching se PEHLE aate hain,
 * taake usi run mein un ka match ho sake.
 */
function syncAllV4() {
  syncAllFromFirestore();

  try {
    syncSettings();
  } catch (error) {
    console.error('Settings sync failed: ' + error);
  }

  try {
    syncPaymentMethods();
  } catch (error) {
    console.error('Payment methods sync failed: ' + error);
  }

  try {
    drainEntryQueue_();
  } catch (error) {
    console.error('Entry queue import failed: ' + error);
  }

  try {
    matchClaims();
  } catch (error) {
    console.error('Claim matching failed: ' + error);
  }
}

function installSyncV4() {
  ScriptApp.getProjectTriggers().forEach(function (trigger) {
    const fn = trigger.getHandlerFunction();
    if (
      fn === 'syncAllFromFirestore' ||
      fn === 'syncAllV4' ||
      fn === 'handleFinanceSheetEdit' ||
      fn === 'handleSheetEdit' ||
      fn === 'buildFinanceMenu'
    ) {
      ScriptApp.deleteTrigger(trigger);
    }
  });

  ScriptApp.newTrigger('syncAllV4')
    .timeBased()
    .everyMinutes(5)
    .create();

  ScriptApp.newTrigger('handleSheetEdit')
    .forSpreadsheet(SpreadsheetApp.getActive())
    .onEdit()
    .create();

  ScriptApp.newTrigger('buildFinanceMenu')
    .forSpreadsheet(SpreadsheetApp.getActive())
    .onOpen()
    .create();

  buildFinanceMenu();

  SpreadsheetApp.getUi().alert(
    'Sync v6 installed.\n\n' +
    'Upar "UTW Finance" ka naya menu aa gaya hai.\n\n' +
    'Ab in tabs mein type karne se data Firebase mein chala jayega:\n' +
    'Payment Entries, Assignments, PayPal Accounts, Notifications,\n' +
    'Settlements, Payment Methods\n\n' +
    'Admin dashboard ke "New entries" se aayi lines har 5 minute\n' +
    'Payment Entries sheet mein khud aa jayengi.\n\n' +
    'Settlements ab Finance Admin dashboard se bante hain.'
  );
}

