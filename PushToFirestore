/* ========================================================================== */

/**
 * Payment Entries ke column numbers, taake neeche wala code parhne mein
 * aasan rahe.
 *
 *   E 5  Email        F 6  UID/phone    I 9  Type
 *   J 10 Gross        K 11 Fee          S 19 Status
 *   V 22 AddedBy      W 23 Notes
 *
 * Formulas L se R tak hain — 12 se 18 (saat columns).
 */
const ENTRY_QUEUE = {
  collection:   'entryQueue',
  maxPerRun:    60,       // ek run mein itni se zyada nahi, 6-minute limit ke liye
  formulaStart: 12,       // L
  formulaCount: 7         // L M N O P Q R
};

/**
 * Sheet mein aisi row dhoondta hai jis ke L..R mein asli formula ho.
 * Usi row se naye rows par formulas copy hote hain.
 *
 * Neeche se upar ki taraf dekhta hai, taake sab se taza formula mile.
 * Kuch na mile to 0 — us surat mein kuch bhi likha nahi jata.
 */
function findFormulaTemplateRow_(sheet) {
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return 0;

  const formulas = sheet
    .getRange(2, ENTRY_QUEUE.formulaStart, lastRow - 1, ENTRY_QUEUE.formulaCount)
    .getFormulas();

  for (let i = formulas.length - 1; i >= 0; i--) {
    const row = formulas[i];
    for (let c = 0; c < row.length; c++) {
      if (String(row[c] || '').charAt(0) === '=') return i + 2;
    }
  }

  return 0;
}

/**
 * entryQueue se un lines ko uthata hai jo abhi sheet mein nahi gayin,
 * aur Payment Entries ki neeche wali khali rows mein daal deta hai.
 *
 * KAAM KI TARTEEB
 *   1) Qatar se pending lines lo, purani pehle
 *   2) Formula wali template row dhoondo — na mile to kuch mat karo
 *   3) Sab lines ki values ek saath likho (E, F, I, J, K, S, V, W)
 *   4) Template se L..R ke formulas poore block par copy karo
 *   5) flush() — taake formulas ka hisab ho jaye
 *   6) Har line ko processed mark karo, PHIR Firestore mein push karo
 *
 * NUQTA 6 KI TARTEEB JAAN BOOJH KAR AISI HAI.
 * Row sheet mein pohanchne ke baad hi processed lag jata hai. Agar us ke
 * baad push nakaam ho jaye to row sheet mein mojood rehti hai aur agli
 * dafa handleSheetEdit ya "Push this tab to Firebase" se chali jayegi.
 * Ulta karte — pehle push, phir mark — to push ke baad koi gadbad hone
 * par wohi line agle run mein DOBARA sheet mein aa jati, aur student ko
 * dugna paisa ja sakta tha. Ek der se push us se behtar hai.
 */
function drainEntryQueue_() {
  const result = { added: 0, failed: 0, left: 0, note: '' };

  const sheet = SpreadsheetApp.getActive().getSheetByName(TABS.entries);
  if (!sheet) {
    result.note = 'Payment Entries tab nahi mila.';
    return result;
  }

  const pending = listCollection_(ENTRY_QUEUE.collection).filter(function (doc) {
    const d = doc.data || {};
    return d.processed !== true;
  });

  if (!pending.length) return result;

  // Purani lines pehle
  pending.sort(function (a, b) {
    const at = (a.data && a.data.createdAt instanceof Date) ? a.data.createdAt.getTime() : 0;
    const bt = (b.data && b.data.createdAt instanceof Date) ? b.data.createdAt.getTime() : 0;
    return at - bt;
  });

  const batch = pending.slice(0, ENTRY_QUEUE.maxPerRun);
  result.left = pending.length - batch.length;

  const template = findFormulaTemplateRow_(sheet);
  if (!template) {
    result.note =
      'Payment Entries mein formula wali koi row nahi mili (L se R). ' +
      'Formula ke baghair rows daalne se sab ka hisab sifar ho jata, ' +
      'is liye kuch nahi likha gaya.';
    console.error(result.note);
    return result;
  }

  clearCaches_();

  const startRow = sheet.getLastRow() + 1;

  // --- 1) values ---
  batch.forEach(function (doc, i) {
    const d = doc.data || {};
    const row = startRow + i;

    sheet.getRange(row,  5).setValue(lower_(d.paypalEmail));
    sheet.getRange(row,  6).setValue(clean_(d.studentPhone));
    sheet.getRange(row,  9).setValue(clean_(d.earningType));
    sheet.getRange(row, 10).setValue(floatOrZero_(d.grossUsd));
    sheet.getRange(row, 11).setValue(floatOrZero_(d.feeUsd));
    sheet.getRange(row, 19).setValue(clean_(d.entryStatus) || 'Pending');
    sheet.getRange(row, 22).setValue(clean_(d.addedBy) || 'dashboard');
    sheet.getRange(row, 23).setValue(clean_(d.notes));
  });

  // --- 2) formulas neeche copy ---
  sheet
    .getRange(template, ENTRY_QUEUE.formulaStart, 1, ENTRY_QUEUE.formulaCount)
    .copyTo(
      sheet.getRange(startRow, ENTRY_QUEUE.formulaStart, batch.length, ENTRY_QUEUE.formulaCount)
    );

  SpreadsheetApp.flush();

  // --- 3) mark, phir push ---
  batch.forEach(function (doc, i) {
    const row = startRow + i;

    try {
      patchDocument_(ENTRY_QUEUE.collection + '/' + doc.id, {
        processed:   true,
        processedAt: new Date(),
        sheetRow:    row,
        updatedAt:   new Date()
      });
    } catch (error) {
      console.error('Queue mark failed for ' + doc.id + ': ' + error);
    }

    try {
      pushRow_(sheet, row, PUSH_SPECS[TABS.entries]);
      result.added++;
    } catch (error) {
      result.failed++;
      console.error('Entry push failed on row ' + row + ': ' + error);
    }
  });

  Logger.log(
    'Entry queue: ' + result.added + ' added, ' +
    result.failed + ' failed, ' + result.left + ' left.'
  );

  return result;
}

/**
 * Menu se chalane ke liye — nateeja dikhata hai.
 */
function drainEntryQueueNow() {
  const r = drainEntryQueue_();

  if (r.note) {
    SpreadsheetApp.getUi().alert('New entries\n\n' + r.note);
    return;
  }

  if (!r.added && !r.failed && !r.left) {
    SpreadsheetApp.getUi().alert(
      'New entries\n\nQatar khali hai — kuch import karne ko nahi.'
    );
    return;
  }

  SpreadsheetApp.getUi().alert(
    'New entries\n\n' +
    'Sheet mein aayi: ' + r.added + '\n' +
    'Nakaam: ' + r.failed + '\n' +
    'Agle run ke liye baqi: ' + r.left +
    (r.failed
      ? '\n\nNakaam rows sheet mein mojood hain. Un ka data theek karke ' +
        '"Push this tab to Firebase" chala dein.'
      : '')
  );
}

